# Mẫu biến môi trường của OptimizeService. Chép thành .env rồi điền giá trị thật; không commit .env.
# Biến không ghi "tuỳ chọn" là bắt buộc: thiếu thì dịch vụ không khởi động.

# =========================
# PostgreSQL — dùng chung biến với LoadMasterService
# =========================
# Tuỳ chọn, mặc định jdbc:postgresql://localhost:5432/loadmaster (như LoadMasterService). Nhận dạng JDBC
# (jdbc:postgresql://host:5432/db?sslmode=require) hoặc dạng SQLAlchemy (postgresql://user:pass@host:5432/db).
# Tham số libpq như sslmode được giữ nguyên; ssl=true không kèm sslmode thành sslmode=verify-full (như pgjdbc);
# tham số chỉ JDBC hiểu bị bỏ.
DATABASE_URL=jdbc:postgresql://localhost:5432/loadmaster
# Tài khoản DB khi URL không ghi tài khoản (cùng biến với spring.datasource.username / password)
POSTGRES_USER=loadmaster
POSTGRES_PASSWORD=your-postgres-password

# =========================
# Môi trường
# =========================
# Tuỳ chọn, mặc định development. development / dev / local mở /docs; production thì tắt.
APP_ENV=development
# Tuỳ chọn: true / false để bật / tắt /docs bất kể APP_ENV.
# API_DOCS_ENABLED=false
# Tuỳ chọn: origin được gọi API, ngăn bằng dấu phẩy; vắng thì FRONTEND_URL (mặc định http://localhost:5173).
# CORS_ALLOWED_ORIGINS=https://app.example.vn

# =========================
# Keycloak
# =========================
# Tuỳ chọn, mặc định Keycloak trên máy. Issuer phải trùng claim iss của token (địa chỉ công khai của Keycloak).
KEYCLOAK_ISSUER=http://localhost:8180/realms/loadmaster
# Tuỳ chọn, mặc định <KEYCLOAK_ISSUER>/protocol/openid-connect/certs
# KEYCLOAK_JWKS_URL=
# Tuỳ chọn, mặc định http://localhost:8180: Keycloak để lấy service token gọi LoadMasterService
KEYCLOAK_AUTH_URL=http://localhost:8180
KEYCLOAK_REALM=loadmaster
KEYCLOAK_CLIENT_ID=optimization-service
KEYCLOAK_CLIENT_SECRET=your-optimization-service-client-secret

# =========================
# LoadMasterService
# =========================
# Tuỳ chọn, mặc định http://localhost:8080
LOADMASTER_SERVICE_URL=http://localhost:8080
