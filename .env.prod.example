# Mẫu cấu hình production cho docker-compose.prod.yml. Chép thành .env.prod, điền giá trị thật, không commit.
# Không đặt SPRING_PROFILES_ACTIVE: production chạy profile mặc định (profile dev tạo tài khoản mẫu).
# OPTIMIZATION_SERVICE_BASE_URL, LOADMASTER_SERVICE_URL, REDIS_HOST, REDIS_PORT do compose đặt sẵn.
# Giá trị có ký tự $ (mật khẩu, secret) thì bọc trong nháy đơn: compose không nội suy chuỗi trong nháy đơn.

# --- Biến của chính docker compose (đọc qua --env-file) ---
IMAGE_TAG=latest
# 127.0.0.1:8080 khi có reverse proxy (nginx/caddy) đứng trước; 0.0.0.0:8080 khi mở thẳng
LOADMASTER_PUBLISH=127.0.0.1:8080
# true: cài torch CPU cho mô hình AI của gói ULTIMATE (image thêm vài GB)
OPTIMIZE_INSTALL_AI=false

# --- Database: Supabase Postgres (dùng chung cho cả hai dịch vụ) ---
# Dạng JDBC, giữ sslmode. Hibernate ddl-auto=update; Flyway không chạy tự động.
DATABASE_URL=jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
POSTGRES_USER=<supabase-user>
POSTGRES_PASSWORD=<supabase-password>
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1

# --- Redis (container redis của compose) ---
REDIS_PASSWORD=<redis-password>

# --- Keycloak dùng chung (bên ngoài), realm loadmaster ---
KEYCLOAK_AUTH_URL=https://<keycloak-host>
LOADMASTER_BACKEND_CLIENT_SECRET=<client-secret-loadmaster-backend-service>
KEYCLOAK_USER_ADMIN_CLIENT_SECRET=<client-secret-user-admin>
# OptimizeService: kiểm token do Keycloak cấp và lấy token gọi LoadMasterService
KEYCLOAK_ISSUER=https://<keycloak-host>/realms/loadmaster
# Vắng thì suy từ KEYCLOAK_ISSUER
#KEYCLOAK_JWKS_URL=
KEYCLOAK_REALM=loadmaster
KEYCLOAK_CLIENT_ID=optimization-service
KEYCLOAK_CLIENT_SECRET=<client-secret-optimization-service>
KEYCLOAK_AUDIENCE=optimization-service
KEYCLOAK_ALLOWED_CLIENT_ID=loadmaster-backend-service
KEYCLOAK_REQUIRED_ROLE=OPTIMIZATION_EXECUTE

# --- Web ---
FRONTEND_URL=https://<web-origin>
CORS_ALLOWED_ORIGINS=https://<web-origin>
API_DOCS_ENABLED=false

# --- Email (Brevo) và OTP ---
BREVO_API_KEY=<brevo-api-key>
BREVO_SENDER_EMAIL=<sender@domain>
BREVO_SENDER_NAME=LoadMaster
OTP_HMAC_SECRET=<random-32-bytes-or-more>

# --- Mật khẩu tạm: bảng ký tự. Bỏ dấu # chỉ khi muốn đổi; biến có mà rỗng sẽ đè mặc định ---
#UPPER=ABCDEFGHIJKLMNOPQRSTUVWXYZ
#LOWER=abcdefghijklmnopqrstuvwxyz
#DIGITS=0123456789

# --- Bản đồ, mã QR ---
GOONG_API_KEY=<goong-rest-key>
QR_AES_SECRET=<random-secret>

# --- Thanh toán VNPay ---
VNPAY_MOCK=false
VNPAY_TMN_CODE=<vnpay-tmn-code>
VNPAY_HASH_SECRET=<vnpay-hash-secret>
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://<api-host>/webhook/vnpay-return

# --- Dùng thử ---
TRIAL_HARD_DELETE_ENABLED=false

# --- OptimizeService ---
APP_ENV=production
APP_PORT=8000
WEB_CONCURRENCY=1
#OPTIMIZATION_ENGINE_URL=
OPTIMIZATION_ENGINE_TIMEOUT_SEC=60
LUMO_MODEL_PATH=app/ml/models/Lumo-R1.1.pt
LUMO_MODELS_DIR=app/ml/models
LUMO_SAMPLES=2
LUMO_TIME_BUDGET_SEC=8.0
METAHEURISTIC_TIME_BUDGET_SEC=6.0
METAHEURISTIC_MAX_EVALUATIONS=60
METAHEURISTIC_MIN_DECODES=5
