# =========================
# LoadMaster PostgreSQL
# =========================
POSTGRES_DB=loadmaster
POSTGRES_USER=loadmaster
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_PORT=5432

# =========================
# Kết nối của LoadMasterService
# =========================
# dev: bật DevAdminInitializer, DevCompanyInitializer và application-dev.yml
SPRING_PROFILES_ACTIVE=dev
# Postgres của docker-compose trên máy. DB dùng chung của nhóm: hỏi người quản lý, không commit địa chỉ đó.
DATABASE_URL=jdbc:postgresql://localhost:5432/loadmaster
# Bắt buộc: application.yml không có giá trị mặc định cho hai biến này
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
# Keycloak mà backend kiểm token; phải trùng Keycloak web và mobile đăng nhập
KEYCLOAK_AUTH_URL=http://localhost:8180
REDIS_URL=redis://localhost:6379

# =========================
# Keycloak PostgreSQL
# =========================
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
#thay các password ở trên bằng password của bạn
KEYCLOAK_DB_PASSWORD=your-keycloak-db-password


# =========================
# Keycloak
# =========================
KEYCLOAK_ADMIN=admin
#thay các password ở trên bằng password của bạn
KEYCLOAK_ADMIN_PASSWORD=your-keycloak-admin-password
KEYCLOAK_PORT=8180

# =========================
# OAuth2 Service Clients
# =========================
LOADMASTER_BACKEND_CLIENT_SECRET=your-loadmaster-backend-client-secret
KEYCLOAK_USER_ADMIN_CLIENT_SECRET=your-keycloak-user-admin-client-secret

# =========================
# Development Bootstrap Admin
# =========================
DEV_ADMIN_EMAIL=admin@loadmaster.local
#thay các password ở trên bằng password của bạn
DEV_ADMIN_PASSWORD=your-dev-admin-password
DEV_ADMIN_FULL_NAME=LoadMaster Admin
# false (mặc định): admin trong DB gắn với Keycloak khác thì chỉ cảnh báo, không sửa DB.
# true: gắn lại admin vào Keycloak đang nối (chỉ đổi keycloak_id) — chỉ bật khi chắc chắn chuyển hẳn sang Keycloak này.
DEV_ADMIN_RELINK=false
# true: khi start profile dev, bù user thiếu giữa Keycloak local và bảng users.
# Mật khẩu không đọc được từ Keycloak/Supabase — user chỉ có trên DB sẽ nhận DEV_USER_SYNC_PASSWORD.
DEV_USER_SYNC=false
# DEV_USER_SYNC_PASSWORD=your-dev-admin-password

#brevo email service configuration
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=loadmaster
OTP_HMAC_SECRET=

# Goong Maps REST API
GOONG_API_KEY=your-goong-rest-api-key

# =========================
# QR Code AES-256 Secret Key
# =========================
QR_AES_SECRET=your-qr-aes-secret-key

# =========================
# VNPay (tuỳ chọn — application.yml đã có giá trị sandbox mặc định)
# =========================
# true: giả lập thanh toán, không gọi VNPay
VNPAY_MOCK=true
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=http://localhost:8080/webhook/vnpay-return
