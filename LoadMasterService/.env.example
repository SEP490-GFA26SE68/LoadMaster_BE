# Mẫu biến môi trường của LoadMasterService. Chép thành .env rồi điền giá trị thật; không commit .env.
# Biến không ghi "tuỳ chọn" là bắt buộc: thiếu thì máy chủ không khởi động.

# =========================
# Profile
# =========================
# Không đặt: không bật profile nào, không ghi dữ liệu mẫu vào DB (dùng khi trỏ vào DB dùng chung).
# dev: bật DevAdminInitializer, DevCompanyInitializer, DevOptimizationMockInitializer và application-dev.yml
#      (tạo admin, công ty, dữ liệu mẫu; thanh toán giả lập). Chỉ đặt trên máy dev với DB của riêng mình.
#      Profile dev cũng mở Swagger UI (/swagger-ui.html) và /v3/api-docs.
SPRING_PROFILES_ACTIVE=dev

# Tuỳ chọn. true: mở Swagger UI và /v3/api-docs (mặc định tắt; profile dev mặc định bật).
# API_DOCS_ENABLED=false

# =========================
# PostgreSQL (docker-compose trên máy)
# =========================
POSTGRES_DB=loadmaster
POSTGRES_USER=loadmaster
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_PORT=5432
# Tuỳ chọn, mặc định Postgres trên máy. DB dùng chung của nhóm: hỏi người quản lý, không commit địa chỉ đó.
DATABASE_URL=jdbc:postgresql://localhost:5432/loadmaster
# Tuỳ chọn: pool kết nối (mặc định tối đa 5, tối thiểu 1). Pooler Supabase dùng chung cả nhóm chỉ có khoảng 15 kết nối.
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1

# =========================
# Redis (mã OTP đặt lại mật khẩu)
# =========================
# Tuỳ chọn, mặc định localhost:6379 không mật khẩu
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# =========================
# Keycloak
# =========================
# Tuỳ chọn, mặc định http://localhost:8180. Keycloak mà backend kiểm token; phải trùng Keycloak web và mobile đăng nhập.
KEYCLOAK_AUTH_URL=http://localhost:8180
# Hai client dịch vụ (client credentials) của realm loadmaster
LOADMASTER_BACKEND_CLIENT_SECRET=your-loadmaster-backend-client-secret
KEYCLOAK_USER_ADMIN_CLIENT_SECRET=your-keycloak-user-admin-client-secret

# Chỉ docker-compose dùng (Keycloak và DB của nó chạy trên máy)
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=your-keycloak-db-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your-keycloak-admin-password
KEYCLOAK_PORT=8180

# =========================
# Web app
# =========================
# Tuỳ chọn, mặc định http://localhost:5173: địa chỉ trong chuyển hướng sau thanh toán, email và hoá đơn.
FRONTEND_URL=http://localhost:5173
# Tuỳ chọn, mặc định bằng FRONTEND_URL: các origin được gọi API, ngăn bằng dấu phẩy.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# =========================
# Dịch vụ tối ưu xếp hàng (Python)
# =========================
# Tuỳ chọn, mặc định http://localhost:8000
# OPTIMIZATION_SERVICE_BASE_URL=http://localhost:8000

# =========================
# Tài khoản mẫu (chỉ profile dev)
# =========================
DEV_ADMIN_EMAIL=admin@loadmaster.local
DEV_ADMIN_PASSWORD=your-dev-admin-password
DEV_ADMIN_FULL_NAME=LoadMaster Admin
# false (mặc định): admin trong DB gắn với Keycloak khác thì chỉ cảnh báo, không sửa DB.
# true: gắn lại admin vào Keycloak đang nối (chỉ đổi keycloak_id) — chỉ bật khi chắc chắn chuyển hẳn sang Keycloak này.
DEV_ADMIN_RELINK=false
# Điều phối viên mẫu để chạy tối ưu xếp hàng trên web (mật khẩu mặc định = DEV_ADMIN_PASSWORD)
DEV_DISPATCHER_EMAIL=dispatcher@loadmaster.local
# DEV_DISPATCHER_PASSWORD=
DEV_DISPATCHER_FULL_NAME=LoadMaster Dispatcher

# =========================
# Email (Brevo) và mã OTP
# =========================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Tuỳ chọn, mặc định loadmaster
BREVO_SENDER_NAME=loadmaster
# Khoá HMAC băm mã OTP
OTP_HMAC_SECRET=

# =========================
# Mật khẩu tạm (tuỳ chọn): bộ ký tự dùng khi sinh mật khẩu tạm
# =========================
# UPPER=ABCDEFGHIJKLMNOPQRSTUVWXYZ
# LOWER=abcdefghijklmnopqrstuvwxyz
# DIGITS=0123456789

# =========================
# Goong Maps REST API (tuỳ chọn: thiếu thì tìm địa chỉ và chỉ đường không chạy)
# =========================
GOONG_API_KEY=your-goong-rest-api-key

# =========================
# Khoá AES-256 của mã QR trên nhãn kiện
# =========================
QR_AES_SECRET=your-qr-aes-secret-key

# =========================
# VNPay
# =========================
# Tuỳ chọn. true: giả lập thanh toán, không gọi VNPay, bỏ kiểm chữ ký callback và mở /api/payment/mock-checkout.
# Mặc định false; profile dev mặc định true. Chỉ để true trên máy dev / bản demo, KHÔNG BAO GIỜ ở môi trường thật.
# mock-checkout đòi đăng nhập và chỉ công ty sở hữu giao dịch xác nhận được; riêng giao dịch đăng ký trả phí
# (mã REG_...) của khách chưa có tài khoản thì không đòi đăng nhập.
VNPAY_MOCK=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Tuỳ chọn, mặc định cổng sandbox và địa chỉ trả về trên máy
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=http://localhost:8080/webhook/vnpay-return

# =========================
# Tài khoản dùng thử
# =========================
# Tuỳ chọn, mặc định false. true: tài khoản dùng thử không ký thoả thuận bị xoá cứng (DB và Keycloak) 30 ngày
# sau khi hết hạn ký. false: chỉ gắn cờ và khoá, không xoá gì.
# TRIAL_HARD_DELETE_ENABLED=false
